# Build artefacts and dependencies — rebuilt inside the image.
frontend/node_modules/
frontend/.next/
frontend/out/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Runtime data — must come from volumes, never be baked into the image.
app/uploads/*
!app/uploads/.gitkeep
app/models/*
!app/models/.gitkeep
dataset/*.csv
logs/
*.db
*.db-wal
*.db-shm

# Local configuration and secrets.
.env
.env.*
!.env.example

# Repository and editor files.
.git/
.gitignore
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
