# ---------------------------------------------------------------------------
# Alzheimer Eye-Tracking Risk API - example environment
# Copy to `.env` and adjust. Every value below is optional; the defaults in
# app/config.py are used for anything you leave out.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="Alzheimer Eye-Tracking Risk API"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json
API_PREFIX=/api

# Comma separated, or a JSON array. Use explicit origins in production.
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# --- Paths (absolute or relative to the process working directory) ---------
# BASE_DIR=/srv/eye-tracking/backend
# UPLOAD_DIR=/srv/eye-tracking/backend/app/uploads
# MODEL_DIR=/srv/eye-tracking/backend/app/models
# DATASET_DIR=/srv/eye-tracking/backend/dataset
# LOG_DIR=/srv/eye-tracking/backend/logs

MODEL_FILENAME=myeye_model.pkl
DATASET_FILENAME=dataset.csv
FRAME_CSV_SUFFIX=_output.csv

DATABASE_URL=sqlite:///./app/eye_tracking.db

# --- Authentication --------------------------------------------------------
# Dashboard at /ui/dashboard.html. Protects /api/train, /api/train/status,
# /api/upload and all of /api/history. /api/predict stays public so
# participants can take the test without an account.
AUTH_ENABLED=true

# The first account is created on first startup ONLY, while the user table is
# still empty. Leave ADMIN_PASSWORD empty and a strong password is generated and
# printed to the log ONCE - there is no built-in default password on purpose.
#
# IMPORTANT: adding ADMIN_PASSWORD here *after* the first start does nothing,
# because the account already exists. To change an existing password use:
#     python scripts/manage_users.py passwd admin
# or set ADMIN_PASSWORD_RESET=true below to apply this value on every start
# (useful for container deployments; it overwrites CLI password changes).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_RESET=false
ADMIN_DISPLAY_NAME=ผู้ดูแลระบบ

SESSION_TTL_MINUTES=720
SESSION_COOKIE_NAME=eyetrack_session
# MUST be true in production - the session cookie then only travels over HTTPS.
# Keep false only for plain-HTTP localhost development.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# --- Frontend --------------------------------------------------------------
SERVE_FRONTEND=true
FRONTEND_MOUNT_PATH=/ui
# FRONTEND_DIR=/srv/eye-tracking/backend/frontend
# Send GET / to the web client so a bare domain lands on the landing page.
# Set to false to keep the liveness JSON at "/". /health is unaffected.
ROOT_REDIRECT_TO_UI=true

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILENAME=app.log

# --- Video ingestion -------------------------------------------------------
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm,.m4v
MAX_UPLOAD_SIZE_MB=200
DEFAULT_FPS=30
MAX_FRAMES=3600
FRAME_RESIZE_WIDTH=640
# Delete the recording once its features have joined dataset.csv. The per-frame
# CSV is kept either way, and cannot be turned back into a face. Set to false
# if your protocol requires the source recordings to be retained.
DELETE_VIDEO_AFTER_DATASET_APPEND=true

# --- MediaPipe FaceMesh ----------------------------------------------------
FACE_MESH_STATIC_MODE=false
FACE_MESH_MAX_FACES=1
FACE_MESH_REFINE_LANDMARKS=true
FACE_MESH_MIN_DETECTION_CONFIDENCE=0.5
FACE_MESH_MIN_TRACKING_CONFIDENCE=0.5

# --- Eye-movement thresholds ----------------------------------------------
# Eye Aspect Ratio below which the eyelid counts as closed.
BLINK_EAR_THRESHOLD=0.21
BLINK_MIN_FRAMES=2
# Speeds are expressed in "eye units" (inter-ocular distances) per second.
SACCADE_VELOCITY_THRESHOLD=1.2
FIXATION_VELOCITY_THRESHOLD=0.35
FIXATION_MIN_FRAMES=3
SMOOTHING_WINDOW=7
SMOOTHING_POLYORDER=2
# Reject a recording when fewer than this share of frames contain a face.
MIN_VALID_FRAME_RATIO=0.30

# --- Model -----------------------------------------------------------------
# Registered implementations: random_forest, gradient_boosting
MODEL_TYPE=random_forest
LABEL_COLUMN=label
POSITIVE_CLASS=1
TEST_SIZE=0.2
RANDOM_STATE=42
CV_FOLDS=5
MODEL_PARAMS={"n_estimators":300,"max_depth":null,"class_weight":"balanced","n_jobs":-1}

# Feature order fed to the estimator; keep it in sync with the trained model.
FEATURE_COLUMNS=eye_velocity,eye_acceleration,eye_distance,movement_smoothness,blink_rate,fixation_time,total_distance,average_velocity,max_velocity,tracking_error

# --- Risk bands ------------------------------------------------------------
RISK_THRESHOLD_LOW=0.34
RISK_THRESHOLD_MODERATE=0.67
RISK_LEVEL_LABELS=Low,Moderate,High
