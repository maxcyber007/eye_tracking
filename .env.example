# ---------------------------------------------------------------------------
# Environment for the docker-compose stack (see DEPLOY.md).
# In Portainer these go in the stack's "Environment variables" section instead.
#
# Copy to .env for local `docker compose up`.
# ---------------------------------------------------------------------------

# Host port to publish the container on.
MYEYE_PORT=8182

# First-run administrator password. Leave empty and one is generated into the
# container log exactly once (`docker logs myeye`).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# MUST be true once served over HTTPS, so the session cookie is never sent in
# clear text. The camera also requires HTTPS — see DEPLOY.md.
SESSION_COOKIE_SECURE=false
SESSION_TTL_MINUTES=720

# Restrict this to your own origin in production.
# e.g. CORS_ALLOW_ORIGINS=https://myeye.itdev.cmtc.ac.th
CORS_ALLOW_ORIGINS=*

# "/" redirects to the assessment page, so a bare domain lands on the UI.
# Set to false to keep the liveness JSON at "/". /health is unaffected.
ROOT_REDIRECT_TO_UI=true

ENVIRONMENT=production
LOG_LEVEL=INFO

# Processing limits — lower these on a small host.
MAX_UPLOAD_SIZE_MB=200
MAX_FRAMES=3600

# Container resource ceiling.
MYEYE_CPUS=2.0
MYEYE_MEMORY=3g
