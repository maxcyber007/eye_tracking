# --- Application data ------------------------------------------------------
# Uploaded recordings and their per-frame CSVs are participant data: never commit.
backend/app/uploads/*
!backend/app/uploads/.gitkeep

# Trained artefacts are rebuilt with POST /api/train.
backend/app/models/*
!backend/app/models/.gitkeep

# The aggregated dataset is research data; keep the directory, drop the content.
backend/dataset/*
!backend/dataset/.gitkeep
!backend/dataset/README.md

